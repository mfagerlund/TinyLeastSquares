<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TinyLeastSquares.Demos</RootNamespace>
  </PropertyGroup>

  <!-- Standalone asset generator: deliberately NOT in TinyLeastSquares.sln so it stays
       out of the package build / release CI. See README for the run command. -->
  <ItemGroup>
    <PackageReference Include="FluentSvg" Version="1.0.0" />
    <ProjectReference Include="..\..\src\TinyLeastSquares\TinyLeastSquares.csproj" />
  </ItemGroup>

</Project>
