<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TinyLeastSquares</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mattias Fagerlund</Authors>
    <Product>TinyLeastSquares</Product>
    <Description>Nano-sized nonlinear least squares (Levenberg-Marquardt) for .NET — dense and sparse, analytic or finite-difference Jacobians, plus an L-BFGS minimizer. No autodiff, one small dependency (CSparse).</Description>
    <PackageTags>least-squares;levenberg-marquardt;optimization;curve-fitting;nonlinear;sparse;lbfgs;numerics;math;jacobian</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSparse" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
